import Foundation
import SwiftUI

public typealias ExperienceDataKeyPath = PartialKeyPath<ExperienceData>

public extension PartialKeyPath where Root == ExperienceData {

    struct Metadata: Identifiable {

        public let name: String
        public let title: String
        public let description: String
        public let grouping: String
        public let dataType: Any.Type
        public let keypath: PartialKeyPath<Root>

        public var id: String {
            return name
        }
    }

    var meta: Metadata? {
        switch self {
{% for variable in type.ExperienceData.storedVariables|annotated: "title" %}
            case \Root.{{ variable.name }}:
                return .init(
                    name: "{{ variable.name }}", 
                    title: "{{ variable.annotations.title }}", 
                    description: "{{ variable.annotations.description }}", 
                    grouping: "{{ variable.annotations.grouping }}", 
                    dataType: {{ variable.typeName }}.self, 
                    keypath: \Root.{{ variable.name }}
                    )
{% endfor %}
            default:
                return nil
        }
    }

    {{ test }}
}

