        var data = Self.init()
    {% for variable in type.ExperienceData.storedVariables|annotated: "default" %}
        data.{{ variable.name }}{#
        #} = {#
        #}defaults.{{ variable.name }}{#
        #}
    {% endfor %}
        return data
    }

    struct Defaults {

{% for variable in type.ExperienceData.storedVariables|annotated: "default" %}
        public let {{ variable.name }}: {{variable.unwrappedTypeName}}
{% endfor %}

        public init(
{% for variable in type.ExperienceData.storedVariables|annotated: "default" %}
            {{ variable.name }}: {{variable.unwrappedTypeName}}{#
